# =========================================================================
# LLM PROVIDER
# =========================================================================
# One of: gemini | openrouter | grok
LLM_PROVIDER=gemini

# Model name — meaning depends on provider:
#   gemini:     gemini-2.5-flash (recommended free tier), gemini-2.5-flash-lite
#   openrouter: a ":free" model THAT SUPPORTS TOOL CALLING (see openrouter.ai/models?max_price=0&supported_parameters=tools)
#   grok:       see console.x.ai for current model names
MODEL=gemini-2.5-flash

# API keys (only set the one matching LLM_PROVIDER)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROK_API_KEY=

# =========================================================================
# TARGET WEBSITE — the ONLY domain the testing tools may contact
# =========================================================================
TARGET_BASE_URL=https://example.com

# =========================================================================
# WEB SEARCH (all free). Works with NO keys via DuckDuckGo + Wikipedia.
# Add a free key for more reliable results:
#   Brave  : https://brave.com/search/api/   (free plan)
#   Tavily : https://tavily.com              (free plan)
# =========================================================================
# auto = Brave (if key) -> Tavily (if key) -> DuckDuckGo -> Wikipedia
SEARCH_PROVIDER=auto
BRAVE_API_KEY=
TAVILY_API_KEY=
# Optional: raises GitHub search rate limit (search_source github)
GITHUB_TOKEN=
SEARCH_TIMEOUT_SECONDS=15
FETCH_MAX_BYTES=2000000
FETCH_MAX_CHARS=12000

# =========================================================================
# TOOL GROUPS — set to false to remove a whole group from the agent
# =========================================================================
ENABLE_WEB_TOOLS=true
ENABLE_TERMINAL_TOOL=true
ENABLE_FILE_TOOLS=true
ENABLE_MEMORY_TOOLS=true
ENABLE_RECON_TOOLS=true

# =========================================================================
# TERMINAL TOOL (PowerShell on Windows, bash elsewhere)
# Every command needs your y/N. Destructive commands are blocked outright.
# =========================================================================
# auto | powershell | cmd | bash
COMMAND_SHELL=auto
COMMAND_TIMEOUT_SECONDS=60
COMMAND_MAX_TIMEOUT_SECONDS=300
COMMAND_MAX_OUTPUT_BYTES=20000
# true = skip the prompt ONLY for a tiny read-only list (git status, ls, pwd,
# node --version ...) with no pipes/redirects. Everything else still asks.
AUTO_APPROVE_SAFE_COMMANDS=false

# =========================================================================
# WORKSPACE — the only folder file tools can touch and where commands run
# =========================================================================
WORKSPACE_DIR=workspace
MAX_FILE_READ_BYTES=200000
MAX_FILE_WRITE_BYTES=1000000
# true = ask y/N before every write_file / replace_in_file
CONFIRM_FILE_WRITES=false
# true = ask y/N before every fetch_url (extra protection against prompt injection)
CONFIRM_FETCH_URL=false

# Memory notes file (remember / recall / forget)
MEMORY_FILE=logs/memory.json

# =========================================================================
# SAFETY LIMITS
# =========================================================================
REQUEST_TIMEOUT_SECONDS=30
# Keep this modest: responses are fed to the LLM, and free tiers have small context windows.
MAX_RESPONSE_BYTES=100000
MAX_TOOL_CALLS_PER_TASK=100
MAX_POST_BODY_BYTES=5000000
MIN_SECONDS_BETWEEN_REQUESTS=0
MAX_TOOL_RESULT_CHARS=30000
MAX_HISTORY_MESSAGES=60
LLM_MAX_RETRIES=3
LOG_FILE_PATH=logs/agent.log
REPORTS_DIR=logs/reports

# Optional: raises NVD's CVE-lookup rate limit. Free: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# =========================================================================
# TARGET-SITE TOGGLES
# =========================================================================
# ON  = every POST/PUT/PATCH/DELETE prints the request and waits for y/N.
ENABLE_CONFIRMATION_PROMPT=false
# ON  = agent waits MIN_SECONDS_BETWEEN_REQUESTS between requests.
ENABLE_RATE_LIMIT=false
# ON  = same-domain redirects are reported back, requiring a fresh tool call.
ENABLE_REDIRECT_CONFIRMATION=false
AUTO_REDIRECT_MAX_HOPS=5
# Only matters when ENABLE_CONFIRMATION_PROMPT=false: path PREFIXES that skip the prompt.
AUTO_APPROVE_POST_PATHS=/

# =========================================================================
# ALWAYS ON — cannot be disabled from .env:
#   - target domain lock + private/loopback/link-local/metadata IP block
#   - SSRF checks on fetch_url (every redirect hop)
#   - workspace jail + secret-file block for file tools
#   - hard deny-list for destructive terminal commands
#   - refusal of credential harvesting, auth bypass, and exploitation
# =========================================================================
